# Personal Coaching Agent — Configuration
# Copy this file to .env and fill in the values.

# Claude API key (get one at https://console.anthropic.com/)
# Leave empty to use planning features without AI coaching.
ANTHROPIC_API_KEY=

# Absolute path to your Obsidian vault root folder.
# Example Mac:   /Users/yourname/Obsidian/MyVault
# Example PC:    C:\Users\yourname\Obsidian\MyVault
VAULT_PATH=
