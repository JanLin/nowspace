# Nowspace Configuration
# Copy this file to config.yaml and adjust paths for your setup.
# The desktop app creates config.yaml automatically on first launch.

vault_path: ~/Obsidian/MyVault/0-Inbox
vault_root: ~/Obsidian/MyVault
memory_path: ./memory/agent_memory.md
system_prompt_path: ./system_prompt.md
vault_sections:
  inbox: 0-Inbox
  projects: 1-Projects
  areas: 2-Areas
  resources: 3-Resources
  archive: 4-Archive
plan:
  week_file: Plan Week.md
  bucket_file: Plan Week Bucket.md
reference_links: {}
# Contexts: separate work / volunteer / personal mentally.
# Map context names to task group prefixes (case-insensitive).
# Groups not listed anywhere count as "personal". Omit or leave empty
# to disable the feature entirely (no context UI is shown).
# Per-task overrides in markdown: trailing @w / @v / @p tokens.
# A trailing @pin surfaces a personal/volunteer task in Work mode.
# contexts:
#   work: [acme, client-x]
#   volunteer: [rotary]
contexts: {}
api:
  model: claude-sonnet-4-6
  max_tokens: 4096
server:
  host: 0.0.0.0
  port: 8000
  cors_origins:
  - http://localhost:5173
  - http://localhost:1420
  - http://localhost:3000
  - http://localhost:8000
  - tauri://localhost
  - https://tauri.localhost

# Feature switch: set to false to hide the Coach tab entirely and skip the
# Anthropic API key requirement (useful for a self-hosted planning-only
# instance, e.g. on an always-on Mac).
coach_enabled: true
